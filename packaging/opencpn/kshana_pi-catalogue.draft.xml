<?xml version="1.0" encoding="UTF-8"?>
<!--
  DRAFT. Catalogue metadata for OpenCPN's plugin manager, for the founder's review.
  NOT submitted anywhere: submitting a plugin to the OpenCPN plugin catalogue is an
  outward step that needs the founder's separate approval (docs/RELEASING.md).

  scripts/package-opencpn-plugin.sh fills the @...@ fields from a real build and writes
  kshana-opencpn-catalogue-draft.xml next to the tarball (a build artifact, never a
  release asset). Before any submission, check against the current OpenCPN plugin-manager
  documentation and the maintainers' catalogue repository:
    - the metadata schema and tarball layout (this follows the layout of the catalogue's
      existing plugins: lib/opencpn/lib<name>_pi.so plus share/opencpn/plugins/<name>_pi/);
    - the target / target-version / target-arch naming per platform, and that a
      Linux build made on Ubuntu 24.04 (glibc 2.39, wxWidgets 3.2) is acceptable;
    - macOS and Windows builds, which this release does not produce.
-->
<plugin version="1">
  <name>kshana_pi</name>
  <version>@VERSION@</version>
  <release>1</release>
  <api-version>1.18</api-version>
  <target>ubuntu-x86_64</target>
  <target-version>24.04</target-version>
  <target-arch>x86_64</target-arch>
  <tarball-url>https://github.com/ashfordeOU/kshana/releases/download/v@VERSION@/kshana-opencpn-plugin-@VERSION@-@PLATFORM@.tar.gz</tarball-url>
  <tarball-checksum>sha256:@SHA256@</tarball-checksum>
  <tarball-size>@SIZE@</tarball-size>
  <summary>Kshana receiver-trust score panel</summary>
  <description>A floating panel showing the Kshana GNSS receiver-trust score, band, gate state and top reasons from the $PKSHT sentence on OpenCPN's NMEA stream, with an alert when trust collapses. Advisory software, not type-approved navigation equipment: the operator stays responsible for the safe navigation of the vessel.</description>
  <author>Ashforde OÜ</author>
  <info-url>https://kshana.dev</info-url>
  <git-repository>https://github.com/ashfordeOU/kshana</git-repository>
  <source-url>https://github.com/ashfordeOU/kshana/releases/download/v@VERSION@/kshana-opencpn-plugin-@VERSION@-source.tar.gz</source-url>
  <license>GPL-3.0-or-later</license>
</plugin>
