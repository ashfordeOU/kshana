<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kshana_trust</name>
  <version>0.38.0</version>
  <description>Receiver-trust scoring of GNSS fixes on ROS 2 topics (advisory software).</description>
  <maintainer email="contact@ashforde.org">Ashforde OÜ</maintainer>
  <license>AGPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- ublox_ubx_msgs (ublox_dgnss) is optional: the node subscribes to it only when importable. -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
