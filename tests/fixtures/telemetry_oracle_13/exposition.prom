# TYPE kshana_trust_input_errors_total counter
kshana_trust_input_errors_total 3
# HELP kshana_trust_reason_overflow_total Reason occurrences folded into reason="other" because 64 distinct reasons were already in use.
# TYPE kshana_trust_reason_overflow_total counter
kshana_trust_reason_overflow_total 0
# HELP kshana_trust_syslog_send_failures_total Syslog events not delivered (queue full, collector down or stalled).
# TYPE kshana_trust_syslog_send_failures_total counter
kshana_trust_syslog_send_failures_total 0
# HELP kshana_trust_epoch_offset_seconds Offset of the latest epoch from the start of the log or session, seconds.
# TYPE kshana_trust_epoch_offset_seconds gauge
kshana_trust_epoch_offset_seconds 63
# HELP kshana_trust_last_sample_timestamp_seconds Wall-clock time the latest epoch was received, Unix seconds. Alert on its age to detect a stalled stream.
# TYPE kshana_trust_last_sample_timestamp_seconds gauge
kshana_trust_last_sample_timestamp_seconds 1790000000
# HELP kshana_trust_geometry Satellite geometry at the latest epoch: 1 for the current status (good, degraded, unknown), 0 for the others.
# TYPE kshana_trust_geometry gauge
kshana_trust_geometry{status="good"} 0
kshana_trust_geometry{status="degraded"} 1
kshana_trust_geometry{status="unknown"} 0
# HELP kshana_trust_geometry_degraded 1 if the satellite geometry at the latest epoch is degraded, 0 if good; absent when unknown.
# TYPE kshana_trust_geometry_degraded gauge
kshana_trust_geometry_degraded 1
# HELP kshana_trust_geometry_signal_loss 1 if satellites in view are not tracked while their geometry is good: the signal was lost, not the sky (geometry still reads degraded); absent when unknown.
# TYPE kshana_trust_geometry_signal_loss gauge
kshana_trust_geometry_signal_loss 1
# HELP kshana_trust_geometry_hdop Horizontal dilution of precision at the latest epoch.
# TYPE kshana_trust_geometry_hdop gauge
kshana_trust_geometry_hdop 2.5
# HELP kshana_trust_geometry_pdop Position dilution of precision at the latest epoch.
# TYPE kshana_trust_geometry_pdop gauge
kshana_trust_geometry_pdop 3.75
