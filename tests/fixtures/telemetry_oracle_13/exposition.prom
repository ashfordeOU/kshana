# TYPE kshana_trust_geometry_used_satellites gauge
kshana_trust_geometry_used_satellites 7
# HELP kshana_trust_geometry_epochs_total Epochs received, by geometry status.
# TYPE kshana_trust_geometry_epochs_total counter
kshana_trust_geometry_epochs_total{status="good"} 12
kshana_trust_geometry_epochs_total{status="degraded"} 16
kshana_trust_geometry_epochs_total{status="unknown"} 28
# HELP kshana_trust_geometry_label Geometry label at the latest epoch: 1 for the current one (good, fair, poor, unknown), 0 for the others; never scored, the score deducts only for poor.
# TYPE kshana_trust_geometry_label gauge
kshana_trust_geometry_label{label="good"} 0
kshana_trust_geometry_label{label="fair"} 1
kshana_trust_geometry_label{label="poor"} 0
kshana_trust_geometry_label{label="unknown"} 0
