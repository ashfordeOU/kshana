{"engine_version":"0.35.0","file":"leo-vertical-asset-tracking-iot.toml","toml":"# LEO-PNT vertical: asset tracking and the Internet of Things (IoT), energy per fix.\n#\n# A battery-powered tag on a shipping container reports its position once an hour along\n# a journey in three phases, each a pass of a generic low Earth orbit (LEO) satellite\n# (550 km, sun-synchronous) in its UHF (465 MHz) and L bands, with the `leo-pass` kind's\n# `[iot]` section (20 mW active, 5 microwatt asleep, 2000 mWh battery, 16 dB detection\n# threshold, parallel code search; every assumption a stated input):\n#\n#   port-hamburg      on the quay, open sky;\n#   north-sea         on deck at sea (maritime user, 8 m/s);\n#   inland-warehouse  inside a traditional building (ITU-R P.2109 median building entry\n#                     loss), where the tag still fixes from the UHF band.\n#\n# Channels: the UHF and L-band carrier-to-noise densities (C/N0) over the pass, and the\n# hot-start energy per UHF fix and battery life at one fix per hour that the pass's\n# median C/N0 gives (constant within a phase). Indoors the lower C/N0 lengthens the\n# acquisition and the energy per fix grows.\n#\n# MODELLED: acquisition, time to first fix and energy from stated receiver assumptions;\n# representative EIRPs; not a measured tag.\nkind = \"campaign\"\ntitle = \"Container tracking with LEO UHF: energy per fix along a journey\"\nseed = 20260929\n\n[timeline]\nstep_s = 10.0\n\n[[phases]]\nname = \"port-hamburg\"\nduration_s = 480.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"uhf_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"l_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n  { channel = \"uhf_hot_energy_per_fix_mj\", unit = \"mJ\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].hot.energy_per_fix_mj\" },\n  { channel = \"uhf_battery_life_hourly_days\", unit = \"day\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].duty_cycle_hot[4].battery_life_days\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Container tag, port-hamburg\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 480.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"ground\"\nlat_deg = 53.54\nlon_deg = 9.97\nheight_m = 5.0\nspeed_m_s = 0.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\"]\nmax_elevation_deg = 60.0\ntca_s = 240.0\n[phases.runs.scenario.gnss]\nconstellation = \"gps-baseline\"\nband = \"L1\"\n[phases.runs.scenario.iot]\nactive_power_mw = 20.0\nsleep_power_uw = 5.0\nbattery_mwh = 2000.0\ndetection_snr_db = 16.0\nmax_coherent_ms = 20.0\nparallel_code_search = true\naided_doppler_uncertainty_hz = 500.0\nfix_intervals_s = [1.0, 10.0, 60.0, 600.0, 3600.0, 86400.0]\ncn0_from = \"median\"\n\n[[phases]]\nname = \"north-sea\"\nduration_s = 480.0\n\n[[phases.runs]]\nseries = [\n  { channel = \"uhf_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[0].cn0_dbhz\" },\n  { channel = \"l_cn0_dbhz\", unit = \"dB-Hz\", t = \"satellites[0].series[].t_s\", y = \"satellites[0].series[].bands[1].cn0_dbhz\" },\n  { channel = \"uhf_hot_energy_per_fix_mj\", unit = \"mJ\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].hot.energy_per_fix_mj\" },\n  { channel = \"uhf_battery_life_hourly_days\", unit = \"day\", t = \"satellites[0].series[].t_s\", y = \"iot.rows[0].duty_cycle_hot[4].battery_life_days\" },\n]\n[phases.runs.scenario]\nkind = \"leo-pass\"\nname = \"Container tag, north-sea\"\nepoch = \"2026-09-28T06:00:00\"\nduration_s = 480.0\nstep_s = 10.0\n[phases.runs.scenario.user]\nenvironment = \"maritime\"\nlat_deg = 54.5\nlon_deg = 6.5\nheight_m = 15.0\nspeed_m_s = 8.0\n[[phases.runs.scenario.satellite]]\nid = \"LEO-1\"\nsystem = \"generic-leo\"\nbands = [\"UHF\", \"L\"]\nmax_elevation_deg = 60.0\ntca_s = 2