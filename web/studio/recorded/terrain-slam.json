k\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"matched_final_m\": {\n      \"note\": \"horizontal position error of the particle-filter estimate at the last waypoint\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"matched_rms_m\": {\n      \"note\": \"root-mean-square particle-filter horizontal position error over every waypoint of the track\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"mean_ess\": {\n      \"note\": \"mean effective sample size of the particle cloud over the track, an effective number of particles and a filter-health monitor\",\n      \"provenance\": \"computed\",\n      \"unit\": \"count\"\n    },\n    \"measurement_sigma_m\": {\n      \"note\": \"1 sigma matching noise used by the terrain-match likelihood: hypot(altimeter sigma, map sigma)\",\n      \"provenance\": \"computed\",\n      \"unit\": \"m\"\n    },\n    \"min_ess\": {\n      \"note\": \"smallest effective sample size seen over the track: the worst-case weight degeneracy of the particle cloud\",\n      \"provenance\": \"computed\",\n      \"unit\": \"count\"\n    },\n    \"waypoints\": {\n      \"note\": \"number of waypoints flown along the track, the configured value floored at 1\",\n      \"provenance\": \"input\",\n      \"unit\": \"count\"\n    }\n  }\n}","svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"720\" height=\"320\" viewBox=\"0 0 720 320\" font-family=\"sans-serif\"><text x=\"16\" y=\"24\" font-size=\"16\" font-weight=\"bold\">Sequential terrain-referenced navigation (recursive SITAN)</text><polyline fill=\"none\" stroke=\"#c0392b\" stroke-width=\"2\" points=\"60.0,280.0 70.8,275.9 81.7,271.9 92.5,267.8 103.4,263.7 114.2,259.7 125.1,255.6 135.9,251.5 146.8,247.4 157.6,243.4 168.5,239.3 179.3,235.2 190.2,231.2 201.0,227.1 211.9,223.0 222.7,219.0 233.6,214.9 244.4,210.8 255.3,206.8 266.1,202.7 276.9,198.6 287.8,194.6 298.6,190.5 309.5,186.4 320.3,182.4 331.2,178.3 342.0,174.