flowchart LR
    subgraph DOORS[Front doors]
        direction TB
        CLI[CLI<br/>kshana run]
        PY[Python wheel<br/>run and run_full]
        WASM[WebAssembly and npm<br/>Kshana Studio in the browser]
        MCP[MCP server<br/>plugins and skills]
        IDE[JetBrains plugin]
        INT[Integrations<br/>ROS 2, Signal K, OpenCPN<br/>GNSS-SDR, Grafana]
    end

    DISPATCH[Single dispatch<br/>api::run_toml<br/>92 ScenarioKind variants]

    subgraph ENGINE[One engine]
        direction TB
        CORE[Shared core<br/>scenario, types, chart, Kalman]
        PACKS[Sensor packs<br/>and Astrodynamics / Frames]
        DOMAIN[Integrity, Fusion, Lunar<br/>Deep-space, Resilience<br/>Referee: trust, packs, bench]
        CORE --> PACKS
        PACKS --> DOMAIN
    end

    OUT[result.json and chart.svg<br/>reproducible: scenario + seed + version]

    CLI --> DISPATCH
    PY --> DISPATCH
    WASM --> DISPATCH
    MCP --> DISPATCH
    IDE --> DISPATCH
    INT --> DISPATCH

    DISPATCH --> ENGINE
    ENGINE --> OUT
