    SCORE --> TEL["Telemetry<br/>Prometheus, CEF, LEEF<br/>OTLP, MQTT"]
    SCORE --> PACK["Signed evidence pack<br/>offline-verifiable"]
    SCORE --> JT["Jammertest and bench scoring<br/>against stated truth"]
    SCORE --> COMP["compliance-report<br/>supports evidence for"]
