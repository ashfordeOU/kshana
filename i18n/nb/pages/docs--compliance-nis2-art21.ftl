seg-7ab034787230 = EUs NIS2-direktiv, artikkel { "21" }: det { -brand } gir belegg for

seg-06480fd207dd = Artikkel { "21" } lister, i punkt (a) til (j) i nr. { "2" }, tiltakene som vesentlige og viktige enheter tar for å håndtere risikoer for nett- og informasjonssystemene sine. De fleste punktene er organisatoriske. { -brand } berører et systems avhengighet av posisjonering og tid: hvordan det oppfører seg når GNSS utsettes for interferens, og hvordan den oppførselen testes og tidfestes.

seg-78690b1d8721 = <b>Direktiv (EU) 2022/2555 om tiltak for et felles høyt nivå av cybersikkerhet i hele Unionen (NIS-{ "2" }-direktivet)</b>: OJ L { "333" }, { "27.12.2022" }, s. 80-152. <a1>https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022L2555</a1>. Lest 2026-10-09: bokstavene i artikkel { "21" } ble lest fra et sammendrag av EUR-Lex-siden og stemmer med den publiserte teksten; kontroller mot siden før du siterer en bokstav i en innlevering.

seg-7b89bc619de7 = Artikkel { "21" }({ "1" })

seg-4409a497d38d = Treffe forholdsmessige tekniske, driftsmessige og organisatoriske tiltak for å håndtere risikoene for nett- og informasjonssystemer, i lys av det nyeste innen teknikken, eksponering, størrelse og sannsynligheten for og alvorlighetsgraden av hendelser.

seg-fe9fc1affe17 = Robusthetsscoring over trusselensembler; Jamming-effekter i linkbudsjettet

seg-c87e37e7f5d1 = { -brand } berører bare et systems avhengighet av posisjonering og tid, ikke informasjonssikkerhetsrisiko generelt.

seg-92f9e470edde = Artikkel { "21" }({ "2" })(a)

seg-963465706e38 = Retningslinjer for risikoanalyse og for sikkerhet i informasjonssystemer.

seg-c92e16fe76f7 = Robusthetsscoring over trusselensembler; Jamming-effekter i linkbudsjettet; Deteksjon av spoofing og meaconing

seg-98b5a42bc971 = Støtter PNT-delen av en risikoanalyse; selve retningslinjen er organisatorisk.

seg-787c5b1ded59 = Artikkel { "21" }({ "2" })(b)

seg-9fc799edec78 = Håndtering av hendelser.

seg-10b2a3a83777 = En mottakerlogg med poengsum hjelper til med å tidfeste start og slutt på en hendelse med PNT-interferens; selve håndteringsprosessen er organisatorisk.

seg-be64837e9260 = Artikkel { "21" }({ "2" })(c)

seg-16930c2c2298 = Driftskontinuitet, for eksempel sikkerhetskopiering, gjenoppretting etter katastrofe og krisehåndtering.

seg-63c69b45f436 = Holdover og coasting; Alternative og varierte PNT-kilder

seg-2c0c7882cf46 = Viser hvor lenge en modellert reserveløsning holder en tids- eller posisjonsgrense; kontinuitetsplaner er organisatoriske.

seg-31ef84b72e29 = Artikkel { "21" }({ "2" })(d)

seg-23b5cc157dbc = Sikkerhet i forsyningskjeden, inkludert forholdet til direkte leverandører.

seg-de99f92e0b1e = { -brand } vurderer ikke leverandører. Å bruke en nøytral, reproduserbar bench for mottakertesting er ett innspill en kjøper kan bruke, ikke en vurdering av forsyningskjeden.

seg-fbdf789ad680 = Artikkel { "21" }({ "2" })(e)

seg-156190872fa8 = Sikkerhet ved anskaffelse, utvikling og vedlikehold av systemer, inkludert håndtering og offentliggjøring av sårbarheter.

seg-f225cb68aea8 = Tillitsvurdering av mottakerlogg; Reproduserbar proveniens for kjøringer

seg-cf27dc445114 = Gjentakbare akseptansetester av en mottakers oppførsel under interferens gir belegg for anskaffelsesdelen; håndtering av sårbarheter ligger utenfor.

seg-0bc7872ae139 = Artikkel { "21" }({ "2" })(f)

seg-fbcba3e644ed = Retningslinjer og prosedyrer for å vurdere hvor effektive tiltakene for styring av cybersikkerhetsrisiko er.

seg-53dd84d385d6 = Hashede, gjentakbare kjøringer og hendelser fastsatt før scoring gir belegg for en effektivitetstest; retningslinjen og tidsplanen for den er organisatoriske.

seg-a6ddbd327818 = Artikkel { "21" }({ "2" })(g) til (j)

seg-d90f31bb999f = Cyberhygiene og opplæring; kryptografi og kryptering; personellsikkerhet, tilgangskontroll og forvaltning av eiendeler; flerfaktorautentisering og sikret kommunikasjon.

