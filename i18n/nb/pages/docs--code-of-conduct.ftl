# docs--code-of-conduct: translations (nb)

seg-955c6b5f38b9 = Kilde: <c1/>

seg-76cf2fbbdc07 = Contributor Covenant: atferdsregler

seg-159ab7b65b97 = Vårt løfte

seg-621b620ca2da = Vi som medlemmer, bidragsytere og ledere lover å gjøre deltakelse i fellesskapet vårt til en trakasseringsfri opplevelse for alle, uavhengig av alder, kroppsstørrelse, synlig eller usynlig funksjonsnedsettelse, etnisitet, kjønnskarakteristikker, kjønnsidentitet og kjønnsuttrykk, erfaringsnivå, utdanning, sosioøkonomisk status, nasjonalitet, personlig utseende, rase, kaste, hudfarge, religion eller seksuell identitet og orientering.

seg-17faa5ea9b6d = Vi lover å handle og samhandle på måter som bidrar til et åpent, imøtekommende, mangfoldig, inkluderende og sunt fellesskap.

seg-2731f1ded8ec = Våre standarder

seg-5016f4dfccfb = Eksempler på atferd som bidrar til et positivt miljø for fellesskapet vårt er:

seg-bdbcfe06d29f = Å vise empati og vennlighet mot andre mennesker

seg-a1299fe3447b = Å være respektfull overfor ulike meninger, synspunkter og erfaringer

seg-065c753f9c7d = Å gi og ta imot konstruktive tilbakemeldinger med letthet

seg-4806be549906 = Å ta ansvar og be om unnskyldning til dem som er rammet av feilene våre, og lære av erfaringen

seg-894eeb3ccede = Å fokusere på det som er best ikke bare for oss som enkeltpersoner, men for fellesskapet som helhet

seg-32de193d3520 = Eksempler på uakseptabel atferd er:

seg-05dd86b3f11d = Bruk av seksualisert språk eller bilder, og seksuell oppmerksomhet eller tilnærmelser av noe slag

seg-e77cf145fd02 = Trolling, fornærmende eller nedsettende kommentarer, og personlige eller politiske angrep

seg-3309de60bddb = Offentlig eller privat trakassering

seg-9607974b6b48 = Å publisere andres private opplysninger, for eksempel en fysisk adresse eller e-postadresse, uten uttrykkelig tillatelse

seg-4678428c1f03 = Annen opptreden som med rimelighet kan anses som upassende i en profesjonell sammenheng

seg-8e1c53718966 = Ansvar for håndheving

seg-2de9f6a8a8b3 = Fellesskapets ledere er ansvarlige for å klargjøre og håndheve våre standarder for akseptabel atferd, og vil gripe til passende og rettferdige korrigerende tiltak overfor enhver atferd de mener er upassende, truende, støtende eller skadelig.

seg-75fef1ab1542 = Fellesskapets ledere har rett og ansvar til å fjerne, redigere eller avvise kommentarer, commits, kode, wiki-endringer, saker og andre bidrag som ikke er i tråd med disse atferdsreglene, og vil gi begrunnelser for moderasjonsbeslutninger når det er hensiktsmessig.

seg-08994a4765be = Virkeområde

seg-0a62c85e8cf3 = Disse atferdsreglene gjelder i alle fellesskapets rom, og gjelder også når en person offisielt representerer fellesskapet i offentlige rom. Eksempler på å representere fellesskapet er å bruke en offisiell e-postadresse, å poste via en offisiell konto i sosiale medier eller å opptre som utnevnt representant på et arrangement på nett eller fysisk.

seg-d387e0c041e6 = Håndheving

seg-54d4988a6315 = Tilfeller av krenkende, trakasserende eller på annen måte uakseptabel atferd kan meldes til fellesskapets ledere som er ansvarlige for håndheving, på <a1>contact@ashforde.org</a1>. Alle klager vil bli gjennomgått og undersøkt raskt og rettferdig.

seg-826819c7b6bf = Alle fellesskapets ledere er forpliktet til å respektere personvernet og sikkerheten til den som melder om en hendelse.

seg-5e5a97c9bdc1 = Retningslinjer for håndheving

seg-09afb39b9789 = Fellesskapets ledere vil følge disse retningslinjene for konsekvenser for fellesskapet når de avgjør konsekvensene av enhver handling de mener bryter disse atferdsreglene:

seg-7acf4903ad52 = { "1" }. Rettelse

seg-ee49590aacdd = <b>Konsekvens for fellesskapet</b>: Bruk av upassende språk eller annen atferd som anses uprofesjonell eller uvelkommen i fellesskapet.

seg-6c7e7f8181cf = <b>Tiltak</b>: En privat, skriftlig advarsel fra fellesskapets ledere som gjør det klart hva bruddet bestod i og forklarer hvorfor atferden var upassende. En offentlig unnskyldning kan bli bedt om.

seg-db3674eeed2e = { "2" }. Advarsel

seg-eb9356b85662 = <b>Konsekvens for fellesskapet</b>: Et brudd gjennom en enkelt hendelse eller en rekke handlinger.

seg-bd1a70f3d25c = <b>Tiltak</b>: En advarsel med konsekvenser hvis atferden fortsetter. Ingen samhandling med de involverte, inkludert uoppfordret samhandling med dem som håndhever atferdsreglene, i en angitt tidsperiode. Dette omfatter å unngå samhandling i fellesskapets rom så vel som i eksterne kanaler som sosiale medier. Brudd på disse vilkårene kan føre til en midlertidig eller permanent utestengelse.

seg-9209f93b77ee = { "3" }. Midlertidig utestengelse

seg-2ceee18edcb0 = <b>Konsekvens for fellesskapet</b>: Et alvorlig brudd på fellesskapets standarder, inkludert vedvarende upassende atferd.

seg-49825371297f = <b>Tiltak</b>: En midlertidig utestengelse fra enhver form for samhandling eller offentlig kommunikasjon med fellesskapet i en angitt tidsperiode. Ingen offentlig eller privat samhandling med de involverte, inkludert uoppfordret samhandling med dem som håndhever atferdsreglene, er tillatt i denne perioden. Brudd på disse vilkårene kan føre til en permanent utestengelse.

seg-602026c2d3ed = { "4" }. Permanent utestengelse

seg-99e67abb8978 = <b>Konsekvens for fellesskapet</b>: Å vise et mønster av brudd på fellesskapets standarder, inkludert vedvarende upassende atferd, trakassering av en enkeltperson, eller aggresjon mot eller nedvurdering av grupper av personer.

seg-809fa976dce8 = <b>Tiltak</b>: En permanent utestengelse fra enhver form for offentlig samhandling i fellesskapet.

seg-86c668236bcd = Kildehenvisning

seg-a61a93ee3757 = Disse atferdsreglene er tilpasset fra <a1>Contributor Covenant</a1>, versjon { "2.1" }, tilgjengelig på <a2>https://www.contributor-covenant.org/version/2/1/code_of_conduct.html</a2>.

seg-6309372ba614 = Retningslinjene for konsekvenser for fellesskapet er inspirert av <a1>Mozillas trapp for håndheving av atferdsregler</a1>.

seg-1a3df1951a1e = For svar på vanlige spørsmål om disse atferdsreglene, se FAQ på <a1>https://www.contributor-covenant.org/faq</a1>. Oversettelser er tilgjengelige på <a2>https://www.contributor-covenant.org/translations</a2>.

seg-d80a7f6811c2 = <s1>Forrige</s1>Styring

