seg-3fb608c6c3ea = байт <c1/> со смещением { "7" }, биты { "4" }..3: <c2/>

seg-54d4cf306b49 = { "0" } неизвестно или отключено, { "1" } спуфинг не обозначен, { "2" } обозначен спуфинг, { "3" } несколько признаков спуфинга (протокол { "18" } и новее; описание интерфейса u-blox F9 HPG { "1.32" }, раздел { "3.15.20" })

seg-36d4d1d82f3d = UBX-SEC-SIG (0x27 0x09) версия { "1" }, { "12" } байт

seg-e7e262087849 = <c1/> со смещением { "4" } (бит { "0" } jamDetEnabled, биты { "2" }..1 jammingState); <c2/> со смещением { "8" } (бит { "0" } spfDetEnabled, биты { "3" }..1 spoofingState)

