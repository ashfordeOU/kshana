# text
seg-551f38a9061c = Rule (pre-registered)

# text
seg-295e8a28a5b9 = at least { "3" } reports in the cell more than { "2000" } m inland of the supplied coastline

# text
seg-fd21160e6685 = a window of { "20" } consecutive reports (stride { "10" }, gaps at most { "30" } min) whose mean radius from the centroid is { "500" } m to { "20" } km, radius coefficient of variation at most { "0.15" }, one direction of travel with total winding of at least { "270" } degrees (steps at most { "90" } degrees, net at least { "80" }% of total), and mean speed at least { "2" } kn

# text
seg-1aa30db06794 = at least { "2" } jumps arriving in the cell: consecutive reports at least { "1000" } m apart, at most { "1" } h apart, implying more than { "70" } kn (the implied speed uses at least { "1" } s between the reports, so two reports with the same time stamp and positions { "1" } km or more apart count as a jump)

# text
seg-7f9b22254009 = at least { "3" } reported speeds above { "70" } kn in the cell

# text
