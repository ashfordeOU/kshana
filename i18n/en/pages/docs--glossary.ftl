seg-800d42de0777 = Orbits, frames and time

# text
seg-320a1594dcf1 = <b>SGP4 / SDP4 — Simplified General Perturbations { "4" } / Simplified Deep-space Perturbations { "4" }.</b> The standard analytic propagators for published satellite orbits.

# text
seg-87a098568846 = <b>TLE — two-line element set.</b> The public orbit format SGP4 reads.

# text
seg-ad15cf5aa9a5 = <b>LEO / MEO / GTO / IGSO — low Earth orbit / medium Earth orbit / geostationary transfer orbit / inclined geosynchronous orbit.</b> Orbit regimes; most GNSS satellites fly in MEO.

# text
seg-1ec323dbd7a6 = LMO — low Mars orbit.

# text
seg-d0be640282af = <b>ECI / ECEF — Earth-centred inertial / Earth-centred, Earth-fixed.</b> A frame that does not rotate with the Earth, and one that does.

# text
seg-09a937adc1db = <b>TEME — true equator, mean equinox.</b> The frame SGP4 outputs in.

# text
seg-eb2a80922118 = <b>GCRS / ITRS / ITRF — Geocentric Celestial Reference System / International Terrestrial Reference System / its realisation, the International Terrestrial Reference Frame.</b> The modern inertial and Earth-fixed frames.

# text
seg-56b24c3734be = <b>CIO — Celestial Intermediate Origin.</b> The reference point of the modern, equinox-free Earth-rotation chain.

# text
seg-a23b05c85a63 = <b>LVLH — local vertical, local horizontal.</b> A frame that moves with the spacecraft.

# text
seg-ac37217cda0d = <b>WGS-84 — World Geodetic System { "1984" }.</b> The Earth ellipsoid GPS uses.

# text
seg-81bc73d1fde8 = UTC / TAI / TT / UT1 / TDB — Coordinated Universal Time / International Atomic Time / Terrestrial Time / Universal Time { "1" } (Earth-rotation time) / Barycentric Dynamical Time.

# text
seg-ea7eb1f34cae = <b>LTC / TCL — Lunar Coordinate Time (Temps-Coordonnée Lunaire).</b> The proposed time scale for the Moon.

# text
seg-c6e5976d9dff = <b>OD — orbit determination.</b> Recovering an orbit from tracking measurements.

# text
seg-dcb9e011c868 = <b>CR3BP</b>, <b>NRHO</b> and <b>DRO</b> are defined under "Orbits & cislunar" above.

