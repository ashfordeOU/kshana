# text
# c1: CODE_OF_CONDUCT.md
seg-955c6b5f38b9 = Allikas: <c1/>

# text
seg-76cf2fbbdc07 = Contributor Covenant käitumisjuhend

# text
seg-159ab7b65b97 = Meie lubadus

# text
seg-621b620ca2da = Meie kui liikmed, panustajad ja juhid lubame teha osalemise meie kogukonnas ahistamisvabaks kogemuseks kõigile, olenemata east, kehasuurusest, nähtavast või nähtamatust puudest, rahvusest, sugutunnustest, soolisest identiteedist ja väljendusest, kogemuste tasemest, haridusest, sotsiaalmajanduslikust staatusest, kodakondsusest, välimusest, rassist, kastist, nahavärvist, usust või seksuaalsest identiteedist ja sättumusest.

# text
seg-17faa5ea9b6d = Lubame tegutseda ja suhelda viisil, mis aitab kaasa avatud, sõbralikule, mitmekesisele, kaasavale ja tervele kogukonnale.

# text
seg-2731f1ded8ec = Meie standardid

# text
seg-5016f4dfccfb = Näited käitumisest, mis aitab kaasa positiivsele keskkonnale meie kogukonnas, on:

# text
seg-bdbcfe06d29f = Empaatia ja lahkuse üles näitamine teiste inimeste suhtes

# text
seg-a1299fe3447b = Lugupidav suhtumine erinevatesse arvamustesse, vaatenurkadesse ja kogemustesse

# text
seg-065c753f9c7d = Konstruktiivse tagasiside andmine ja viisakas vastuvõtmine

# text
seg-4806be549906 = Vastutuse võtmine ja vabandamine neile, keda meie vead on mõjutanud, ning kogemusest õppimine

# text
seg-894eeb3ccede = Keskendumine sellele, mis on parim mitte ainult meile kui üksikisikutele, vaid kogukonnale tervikuna

# text
seg-32de193d3520 = Näited vastuvõetamatust käitumisest on:

# text
seg-05dd86b3f11d = Seksualiseeritud keele või kujutiste kasutamine ning igasugune seksuaalne tähelepanu või ligitikkumine

# text
seg-e77cf145fd02 = Trollimine, solvavad või halvustavad kommentaarid ning isiklikud või poliitilised rünnakud

# text
seg-3309de60bddb = Avalik või privaatne ahistamine

# text
seg-9607974b6b48 = Teiste inimeste privaatse teabe, näiteks füüsilise või e-posti aadressi avaldamine ilma nende selgesõnalise loata

# text
seg-4678428c1f03 = Muu käitumine, mida võib põhjendatult pidada kutsekeskkonnas sobimatuks

# text
seg-8e1c53718966 = Jõustamise vastutus

# text
seg-2de9f6a8a8b3 = Kogukonna juhid vastutavad vastuvõetava käitumise standardite selgitamise ja jõustamise eest ning rakendavad sobivaid ja õiglasi parandusmeetmeid vastusena igale käitumisele, mida nad peavad sobimatuks, ähvardavaks, solvavaks või kahjulikuks.

# text
seg-75fef1ab1542 = Kogukonna juhtidel on õigus ja kohustus eemaldada, muuta või tagasi lükata kommentaare, commit’e, koodi, wiki muudatusi, probleeme ja muid panuseid, mis ei ole kooskõlas selle käitumisjuhendiga, ning nad teavitavad modereerimisotsuste põhjustest, kui see on asjakohane.

# text
seg-08994a4765be = Ulatus

# text
seg-0a62c85e8cf3 = See käitumisjuhend kehtib kõigis kogukonna ruumides ning ka siis, kui üksikisik esindab ametlikult kogukonda avalikes ruumides. Kogukonna esindamise näited on ametliku e-posti aadressi kasutamine, postitamine ametliku sotsiaalmeedia konto kaudu või määratud esindajana tegutsemine veebi- või kohapealsel üritusel.

# text
seg-d387e0c041e6 = Jõustamine

# text
seg-54d4988a6315 = Kuritahtlikust, ahistavast või muul viisil vastuvõetamatust käitumisest võib teatada jõustamise eest vastutavatele kogukonna juhtidele aadressil <a1>contact@ashforde.org</a1>. Kõik kaebused vaadatakse läbi ja uuritakse kiiresti ja õiglaselt.

# text
seg-826819c7b6bf = Kõik kogukonna juhid on kohustatud austama mis tahes intsidendist teavitaja privaatsust ja turvalisust.

# text
seg-5e5a97c9bdc1 = Jõustamise juhised

# text
seg-09afb39b9789 = Kogukonna juhid järgivad neid kogukonna mõju juhiseid, et määrata tagajärjed mis tahes tegevuse eest, mida nad peavad selle käitumisjuhendi rikkumiseks:

# text
seg-7acf4903ad52 = { "1" }. Parandamine

# text
seg-ee49590aacdd = <b>Kogukonna mõju</b>: sobimatu keelekasutus või muu käitumine, mida peetakse kogukonnas ebaprofessionaalseks või ebasoovitavaks.

# text
seg-6c7e7f8181cf = <b>Tagajärg</b>: kogukonna juhtide privaatne kirjalik hoiatus, mis selgitab rikkumise olemust ja põhjendab, miks käitumine oli sobimatu. Võidakse paluda avalikku vabandust.

# text
seg-db3674eeed2e = { "2" }. Hoiatus

# text
seg-eb9356b85662 = <b>Kogukonna mõju</b>: rikkumine ühe intsidendi või tegevuste seeria kaudu.

# text
seg-bd1a70f3d25c = <b>Tagajärg</b>: hoiatus tagajärgedega käitumise jätkumise korral. Teatud ajaperioodi jooksul ei suhelda asjaosalistega, sealhulgas ei algata soovimatut suhtlust käitumisjuhendi jõustajatega. See hõlmab suhtlemise vältimist kogukonna ruumides ja välistes kanalites, nagu sotsiaalmeedia. Nende tingimuste rikkumine võib kaasa tuua ajutise või püsiva keelu.

# text
seg-9209f93b77ee = { "3" }. Ajutine keeld

# text
seg-2ceee18edcb0 = <b>Kogukonna mõju</b>: kogukonna standardite tõsine rikkumine, sealhulgas püsiv sobimatu käitumine.

# text
seg-49825371297f = <b>Tagajärg</b>: ajutine keeld igasuguseks suhtluseks või avalikuks suhtlemiseks kogukonnaga teatud ajaperioodiks. Sel perioodil ei ole lubatud avalik ega privaatne suhtlus asjaosalistega, sealhulgas soovimatu suhtlus käitumisjuhendi jõustajatega. Nende tingimuste rikkumine võib kaasa tuua püsiva keelu.

# text
seg-602026c2d3ed = { "4" }. Püsiv keeld

# text
seg-99e67abb8978 = <b>Kogukonna mõju</b>: kogukonna standardite rikkumise mustri üles näitamine, sealhulgas püsiv sobimatu käitumine, üksikisiku ahistamine või agressioon isikute klasside vastu või nende halvustamine.

# text
seg-809fa976dce8 = <b>Tagajärg</b>: püsiv keeld igasuguseks avalikuks suhtluseks kogukonnas.

# text
seg-86c668236bcd = Viitamine

# text
seg-a61a93ee3757 = See käitumisjuhend on kohandatud dokumendist <a1>Contributor Covenant</a1>, versioon { "2.1" }, kättesaadav aadressil <a2>https://www.contributor-covenant.org/version/2/1/code_of_conduct.html</a2>.

# text
seg-6309372ba614 = Kogukonna mõju juhised said inspiratsiooni <a1>Mozilla käitumisjuhendi jõustamise redelist</a1>.

# text
seg-1a3df1951a1e = Vastuseid selle käitumisjuhendi kohta sagedamini esitatavatele küsimustele vt KKK-st aadressil <a1>https://www.contributor-covenant.org/faq</a1>. Tõlked on kättesaadavad aadressil <a2>https://www.contributor-covenant.org/translations</a2>.

