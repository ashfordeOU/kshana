# Glossary terms (Polish).

## Evidence tiers
-tier-validated = VALIDATED
    .gloss = sprawdzone względem niezależnego wzorca zewnętrznego
-tier-modelled = MODELLED
    .gloss = obliczone na podstawie modelu, bez zewnętrznego wzorca
-tier-partner = PARTNER
    .gloss = część partnera; Kshana jej nie zapewnia
-tier-exploratory = EXPLORATORY
    .gloss = nieustalone z góry jako wniosek

## Verdicts against a pre-registered bar
-verdict-met = MET
    .gloss = osiągnięto próg ustalony z góry
-verdict-not-met = NOT MET
    .gloss = nie osiągnięto progu ustalonego z góry

