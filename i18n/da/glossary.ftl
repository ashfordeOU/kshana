# Ordliste (dansk). Se den engelske kilde for forklaring.

## Evidence tiers
-tier-validated = VALIDATED
    .gloss = kontrolleret mod en uafhængig ekstern reference
-tier-modelled = MODELLED
    .gloss = beregnet ud fra en model, uden ekstern reference
-tier-partner = PARTNER
    .gloss = partnerens del; Kshana leverer den ikke
-tier-exploratory = EXPLORATORY
    .gloss = ikke fastlagt på forhånd som konklusion

## Verdicts against a pre-registered bar
-verdict-met = MET
    .gloss = den tærskel, der blev fastsat på forhånd, blev nået
-verdict-not-met = NOT MET
    .gloss = den tærskel, der blev fastsat på forhånd, blev ikke nået

