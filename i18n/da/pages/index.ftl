seg-5a742c1e1563 = Optaget kørsel af <c1/> (seed { "7" }, motor v{ $version }): { "5" } GNSS-bånd, { "3" } jammere over { "60" } s, sporingsgrænse { "25" } dB-Hz. Jammere: chirp-privatlivsenhed ved { "1,575.42" } MHz fra { "10" } s til { "40" } s; CW-tone på L1 ved { "1,575.42" } MHz fra { "30" } s til slutningen; L2-smalbåndsstøj ved { "1,227.60" } MHz fra { "45" } s til slutningen.

seg-45d6be782732 = GPS L1 C/A mister låsning ved { "10" } s og forbliver tabt, laveste { "3.2" } dB-Hz. Galileo E1 mister låsning ved { "10" } s og genfinder den ved { "40" } s, laveste { "4.4" } dB-Hz. GPS L2C sporer hele vejen, laveste { "36.9" } dB-Hz. GPS L5 sporer hele vejen, laveste { "44.1" } dB-Hz. Galileo E5a sporer hele vejen, laveste { "46.7" } dB-Hz.

seg-ba40ce1e86f4 = Kampagnen, den driver, <c1/> (seed { "20260928" }): L-bånd-jamming fra spektret, urets holdover og en reserve kun med Galileo. Holdover i { "600" } s med uret i fri gang, værste tidsfejl { "5.06" } ns mod en sikkerhedsmargen på { "50" } ns; derefter en reserve kun med Galileo med et beskyttelsesniveau på { "6.1" } til { "17.7" } m, under alarmgrænsen på { "50" } m.

