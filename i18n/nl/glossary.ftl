# Verklarende woordenlijst (Nederlands).

## Evidence tiers
-tier-validated = VALIDATED
    .gloss = getoetst aan een onafhankelijke externe referentie
-tier-modelled = MODELLED
    .gloss = berekend uit een model, zonder externe referentie
-tier-partner = PARTNER
    .gloss = het aandeel van de partner; Kshana levert dit niet
-tier-exploratory = EXPLORATORY
    .gloss = niet vooraf als conclusie vastgelegd

## Verdicts against a pre-registered bar
-verdict-met = MET
    .gloss = de vooraf vastgelegde drempel is gehaald
-verdict-not-met = NOT MET
    .gloss = de vooraf vastgelegde drempel is niet gehaald

