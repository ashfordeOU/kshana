# docs--code-of-conduct: translations (nl)

seg-955c6b5f38b9 = Bron: <c1/>

seg-76cf2fbbdc07 = Contributor Covenant: gedragscode

seg-159ab7b65b97 = Onze belofte

seg-621b620ca2da = Wij, als leden, bijdragers en leiders, beloven dat deelname aan onze gemeenschap voor iedereen een intimidatievrije ervaring is, ongeacht leeftijd, lichaamsgrootte, zichtbare of onzichtbare beperking, etniciteit, geslachtskenmerken, genderidentiteit en -expressie, ervaringsniveau, opleiding, sociaal-economische status, nationaliteit, persoonlijk voorkomen, ras, kaste, huidskleur, religie of seksuele identiteit en oriëntatie.

seg-17faa5ea9b6d = Wij beloven te handelen en met elkaar om te gaan op manieren die bijdragen aan een open, gastvrije, diverse, inclusieve en gezonde gemeenschap.

seg-2731f1ded8ec = Onze normen

seg-5016f4dfccfb = Voorbeelden van gedrag dat bijdraagt aan een positieve omgeving voor onze gemeenschap zijn:

seg-bdbcfe06d29f = Empathie en vriendelijkheid tonen jegens andere mensen

seg-a1299fe3447b = Respect hebben voor afwijkende meningen, standpunten en ervaringen

seg-065c753f9c7d = Constructieve feedback geven en er sportief mee omgaan

seg-4806be549906 = Verantwoordelijkheid nemen en excuses aanbieden aan wie door onze fouten is geraakt, en leren van de ervaring

seg-894eeb3ccede = Ons richten op wat het beste is, niet alleen voor ons als individuen, maar voor de gemeenschap als geheel

seg-32de193d3520 = Voorbeelden van onaanvaardbaar gedrag zijn:

seg-05dd86b3f11d = Het gebruik van geseksualiseerde taal of beeldspraak, en seksuele aandacht of avances van welke aard ook

seg-e77cf145fd02 = Trollen, beledigende of denigrerende opmerkingen, en persoonlijke of politieke aanvallen

seg-3309de60bddb = Publieke of private intimidatie

seg-9607974b6b48 = Privégegevens van anderen, zoals een fysiek adres of e-mailadres, publiceren zonder hun uitdrukkelijke toestemming

seg-4678428c1f03 = Ander gedrag dat redelijkerwijs als ongepast in een professionele omgeving kan worden beschouwd

seg-8e1c53718966 = Verantwoordelijkheden bij de handhaving

seg-2de9f6a8a8b3 = Leiders van de gemeenschap zijn verantwoordelijk voor het verduidelijken en handhaven van onze normen voor aanvaardbaar gedrag en nemen passende en eerlijke corrigerende maatregelen naar aanleiding van gedrag dat zij ongepast, bedreigend, kwetsend of schadelijk achten.

seg-75fef1ab1542 = Leiders van de gemeenschap hebben het recht en de verantwoordelijkheid om opmerkingen, commits, code, wikibewerkingen, issues en andere bijdragen die niet in lijn zijn met deze gedragscode te verwijderen, te bewerken of af te wijzen, en zullen waar passend de redenen voor moderatiebeslissingen meedelen.

seg-08994a4765be = Reikwijdte

seg-0a62c85e8cf3 = Deze gedragscode geldt binnen alle ruimten van de gemeenschap en ook wanneer een individu de gemeenschap officieel vertegenwoordigt in openbare ruimten. Voorbeelden van het vertegenwoordigen van onze gemeenschap zijn het gebruik van een officieel e-mailadres, het plaatsen van berichten via een officieel socialemedia-account of het optreden als aangewezen vertegenwoordiger bij een online of offline evenement.

seg-d387e0c041e6 = Handhaving

seg-54d4988a6315 = Gevallen van beledigend, intimiderend of anderszins onaanvaardbaar gedrag kunnen worden gemeld aan de leiders van de gemeenschap die verantwoordelijk zijn voor de handhaving, via <a1>contact@ashforde.org</a1>. Alle klachten worden snel en eerlijk beoordeeld en onderzocht.

seg-826819c7b6bf = Alle leiders van de gemeenschap zijn verplicht de privacy en veiligheid van de melder van een incident te respecteren.

seg-5e5a97c9bdc1 = Richtlijnen voor handhaving

seg-09afb39b9789 = Leiders van de gemeenschap volgen deze Community Impact Guidelines bij het bepalen van de gevolgen van elke handeling die zij als een schending van deze gedragscode beschouwen:

seg-7acf4903ad52 = { "1" }. Correctie

seg-ee49590aacdd = <b>Impact op de gemeenschap</b>: Gebruik van ongepaste taal of ander gedrag dat in de gemeenschap als onprofessioneel of ongewenst wordt beschouwd.

seg-6c7e7f8181cf = <b>Gevolg</b>: Een privé, schriftelijke waarschuwing van de leiders van de gemeenschap, met duidelijkheid over de aard van de schending en een uitleg waarom het gedrag ongepast was. Er kan om een openbare verontschuldiging worden gevraagd.

seg-db3674eeed2e = { "2" }. Waarschuwing

seg-eb9356b85662 = <b>Impact op de gemeenschap</b>: Een schending door één incident of een reeks handelingen.

seg-bd1a70f3d25c = <b>Gevolg</b>: Een waarschuwing met gevolgen voor voortgezet gedrag. Gedurende een bepaalde periode geen interactie met de betrokken personen, inclusief ongevraagde interactie met degenen die de gedragscode handhaven. Dit omvat het vermijden van interactie in ruimten van de gemeenschap en op externe kanalen zoals sociale media. Schending van deze voorwaarden kan leiden tot een tijdelijk of permanent verbod.

seg-9209f93b77ee = { "3" }. Tijdelijk verbod

seg-2ceee18edcb0 = <b>Impact op de gemeenschap</b>: Een ernstige schending van de normen van de gemeenschap, waaronder aanhoudend ongepast gedrag.

seg-49825371297f = <b>Gevolg</b>: Een tijdelijk verbod op elke vorm van interactie of openbare communicatie met de gemeenschap gedurende een bepaalde periode. Gedurende deze periode is geen openbare of private interactie met de betrokken personen toegestaan, inclusief ongevraagde interactie met degenen die de gedragscode handhaven. Schending van deze voorwaarden kan leiden tot een permanent verbod.

seg-602026c2d3ed = { "4" }. Permanent verbod

seg-99e67abb8978 = <b>Impact op de gemeenschap</b>: Het vertonen van een patroon van schending van de normen van de gemeenschap, waaronder aanhoudend ongepast gedrag, intimidatie van een individu, of agressie tegen of denigratie van groepen individuen.

seg-809fa976dce8 = <b>Gevolg</b>: Een permanent verbod op elke vorm van openbare interactie binnen de gemeenschap.

seg-86c668236bcd = Bronvermelding

seg-a61a93ee3757 = Deze gedragscode is aangepast uit het <a1>Contributor Covenant</a1>, versie { "2.1" }, beschikbaar op <a2>https://www.contributor-covenant.org/version/2/1/code_of_conduct.html</a2>.

seg-6309372ba614 = De Community Impact Guidelines zijn geïnspireerd op de <a1>handhavingsladder van Mozilla's gedragscode</a1>.

seg-1a3df1951a1e = Voor antwoorden op veelgestelde vragen over deze gedragscode, zie de FAQ op <a1>https://www.contributor-covenant.org/faq</a1>. Vertalingen zijn beschikbaar op <a2>https://www.contributor-covenant.org/translations</a2>.

