# Slovník pojmů (cs).

## Evidence tiers
-tier-validated = VALIDATED
    .gloss = ověřeno proti nezávislé vnější referenci
-tier-modelled = MODELLED
    .gloss = vypočteno z modelu, bez vnější reference
-tier-partner = PARTNER
    .gloss = část partnera; Kshana ji neposkytuje
-tier-exploratory = EXPLORATORY
    .gloss = předem nestanoveno jako závěr

## Verdicts against a pre-registered bar
-verdict-met = MET
    .gloss = předem stanovený práh byl dosažen
-verdict-not-met = NOT MET
    .gloss = předem stanovený práh nebyl dosažen

