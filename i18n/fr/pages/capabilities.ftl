# c1: l-band-waterfall-jamming.toml
seg-5a742c1e1563 = Exécution enregistrée de <c1/> (graine { "7" }, moteur v{ $version }) : { "5" } bandes GNSS, { "3" } brouilleurs sur { "60" } s, plancher de poursuite { "25" } dB-Hz. Brouilleurs : dispositif de confidentialité à balayage à { "1,575.42" } MHz de { "10" } s à { "40" } s ; tonalité CW sur L1 à { "1,575.42" } MHz de { "30" } s jusqu'à la fin ; bruit à bande étroite sur L2 à { "1,227.60" } MHz de { "45" } s jusqu'à la fin.

# text
seg-45d6be782732 = GPS L1 C/A perd l'accrochage à { "10" } s et ne le retrouve pas, minimum { "3.2" } dB-Hz. Galileo E1 perd l'accrochage à { "10" } s et le retrouve à { "40" } s, minimum { "4.4" } dB-Hz. GPS L2C poursuit sans interruption, minimum { "36.9" } dB-Hz. GPS L5 poursuit sans interruption, minimum { "44.1" } dB-Hz. Galileo E5a poursuit sans interruption, minimum { "46.7" } dB-Hz.

# text
# c1: campaign-spectrum-holdover-integrity.toml
seg-ba40ce1e86f4 = La campagne qu'elle pilote, <c1/> (graine { "20260928" }) : brouillage en bande L issu du spectre, holdover d'horloge et repli sur Galileo seul. Holdover pendant { "600" } s avec l'horloge en marche libre, pire erreur de temps { "5.06" } ns pour une garde de { "50" } ns ; puis un repli sur Galileo seul avec un niveau de protection de { "6.1" } à { "17.7" } m, sous la limite d'alerte de { "50" } m.

