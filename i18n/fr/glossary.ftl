# Glossary (fr).

## Evidence tiers
-tier-validated = VALIDATED
    .gloss = vérifié par rapport à une référence externe indépendante
-tier-modelled = MODELLED
    .gloss = calculé à partir d'un modèle, sans référence externe
-tier-partner = PARTNER
    .gloss = la part du partenaire ; Kshana ne la fournit pas
-tier-exploratory = EXPLORATORY
    .gloss = non défini à l'avance comme une conclusion

## Verdicts against a pre-registered bar
-verdict-met = MET
    .gloss = le seuil fixé à l'avance a été atteint
-verdict-not-met = NOT MET
    .gloss = le seuil fixé à l'avance n'a pas été atteint

