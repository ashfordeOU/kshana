seg-7ab034787230 = EU:s NIS2-direktiv, artikel { "21" }: vad Kshana ger belägg för

seg-06480fd207dd = Artikel { "21" } listar, i punkt { "2" } led (a) till (j), de åtgärder som väsentliga och viktiga entiteter vidtar för att hantera risker för sina nät- och informationssystem. De flesta led är organisatoriska. Kshana gäller systemets beroende av positionering och tidssynkronisering: hur det beter sig när GNSS störs, och hur det beteendet testas och dateras.

seg-78690b1d8721 = <b>Directive (EU) 2022/2555 on measures for a high common level of cybersecurity across the Union (NIS { "2" } Directive)</b>: OJ L { "333" }, { "27.12.2022" }, s. 80-152. <a1>https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32022L2555</a1>. Läst 2026-10-09: bokstäverna för led i artikel { "21" } lästes från en sammanfattning av EUR-Lex-sidan och stämmer med den publicerade texten; kontrollera mot sidan innan du hänvisar till en bokstav i en inlaga.

seg-7b89bc619de7 = Artikel { "21" }({ "1" })

seg-4409a497d38d = Vidta proportionella tekniska, operativa och organisatoriska åtgärder för att hantera riskerna för nät- och informationssystem, med hänsyn till den senaste utvecklingen, exponering, storlek samt sannolikheten för och allvarlighetsgraden av incidenter.

seg-fe9fc1affe17 = Resiliensbedömning över hotuppsättningar; Effekter av jamming på länkbudgeten

seg-c87e37e7f5d1 = Kshana gäller endast ett systems beroende av positionering och tidssynkronisering, inte informationssäkerhetsrisker i allmänhet.

seg-92f9e470edde = Artikel { "21" }({ "2" })(a)

seg-963465706e38 = Policyer för riskanalys och för informationssystemssäkerhet.

seg-c92e16fe76f7 = Resiliensbedömning över hotuppsättningar; Effekter av jamming på länkbudgeten; Detektering av spoofing och meaconing

seg-98b5a42bc971 = Ger belägg för PNT-delen av en riskanalys; själva policyn är organisatorisk.

seg-787c5b1ded59 = Artikel { "21" }({ "2" })(b)

seg-9fc799edec78 = Incidenthantering.

seg-10b2a3a83777 = En poängsatt mottagarlogg hjälper till att datera början och slutet på en PNT-störningsincident; hanteringsprocessen är organisatorisk.

seg-be64837e9260 = Artikel { "21" }({ "2" })(c)

seg-16930c2c2298 = Kontinuitet i verksamheten, till exempel hantering av säkerhetskopior, katastrofåterställning och krishantering.

seg-63c69b45f436 = Holdover och fortsatt färd utan GNSS; Alternativa och diversifierade PNT-källor

seg-2c0c7882cf46 = Visar hur länge en modellerad reservlösning håller en tids- eller positionsgräns; kontinuitetsplaner är organisatoriska.

seg-31ef84b72e29 = Artikel { "21" }({ "2" })(d)

seg-23b5cc157dbc = Säkerhet i leveranskedjan, inklusive relationer med direkta leverantörer.

seg-de99f92e0b1e = Kshana bedömer inte leverantörer. Att använda en neutral, reproducerbar bench för mottagaracceptans är ett underlag som en köpare kan använda, inte en bedömning av leveranskedjan.

seg-fbdf789ad680 = Artikel { "21" }({ "2" })(e)

seg-156190872fa8 = Säkerhet vid anskaffning, utveckling och underhåll av system, inklusive hantering och utlämnande av sårbarheter.

seg-f225cb68aea8 = Bedömning av förtroende i mottagarloggar; Reproducerbart ursprung för körningar

seg-cf27dc445114 = Repeterbara acceptanstester av en mottagares störningsbeteende ger belägg för anskaffningsdelen; hantering av sårbarheter ligger utanför.

seg-0bc7872ae139 = Artikel { "21" }({ "2" })(f)

seg-fbcba3e644ed = Policyer och rutiner för att bedöma hur effektiva åtgärderna för riskhantering inom cybersäkerhet är.

seg-53dd84d385d6 = Körningar med hashvärden som går att upprepa och händelser som angavs före poängsättningen ger belägg för ett effektivitetstest; policyn och dess tidsplan är organisatoriska.

seg-a6ddbd327818 = Artikel { "21" }({ "2" })(g) till (j)

seg-d90f31bb999f = Cyberhygien och utbildning; kryptografi och kryptering; personalsäkerhet, åtkomstkontroll och tillgångshantering; flerfaktorsautentisering och säkrad kommunikation.

seg-4b3bd4a5a2cc = Kan inte hanteras med utdata från körningar av positionering och tidssynkronisering.

seg-172dc5790e63 = Artikel { "21" }({ "3" })

seg-bac57643572d = Vid val av åtgärder för leveranskedjan, beakta varje leverantörs sårbarheter samt kvaliteten på och den säkra utvecklingen av dess produkter.

seg-0d9efc2b8b59 = Se artikel { "21" }({ "2" })(d).

